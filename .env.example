# ---------------------------------------------------------------------------
# MediQueue environment variables
# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# Public values (browser-exposed). Prefix NEXT_PUBLIC_ so Next.js inlines them.
# Project URL: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Use the "Publishable key" from the dashboard. The legacy "anon public" key
# also works — either put it below or use NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side copies (optional; the app falls back to the NEXT_PUBLIC_ ones).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Service-role secret — server ONLY. Never expose or commit this value.
# Accepted aliases: SUPABASE_SECRET_KEY or SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Optional: asymmetric JWT verification endpoint.
SUPABASE_JWKS_URL=

# Field-level AES-256-GCM key for clinical notes (use 32+ random characters).
FIELD_ENCRYPTION_KEY=
